# Copy this file to .env and fill in your key from app.gnani.ai -> API Keys
GNANI_API_KEY=

# Optional: Evon v3.3 served by any OpenAI-compatible server (vLLM, llama.cpp, LM Studio)
# EVON_BASE_URL=http://localhost:1234/v1
# EVON_MODEL=gnani-evon-v3.3
# EVON_API_KEY=

# Set to 0 to turn off Prisma keyterms/topic hints (to measure how much they help)
USE_CONTEXT=1

# Live mic listening. Lower VAD_THRESHOLD (0.3-0.5) if a phone on speaker is not fully heard;
# raise it (0.6) if room noise creates junk transcripts. MIN_SILENCE_MS: pause that ends a sentence.
VAD_THRESHOLD=0.5
MIN_SILENCE_MS=800
# Force a transcript after this many seconds of continuous sound (helps in noisy rooms).
MAX_SPEECH_S=8

# Save what the mic captured to recordings/ (for debugging missed speech). Off by default.
SAVE_AUDIO=0
